# GIDBoy Configuration

# =============================================================================
# LLM PROVIDER OPTIONS (All have FREE options available!)
# =============================================================================

# OPTION 1: Ollama (LOCAL - FREE, runs on your machine)
# Website: https://ollama.com
# Install: curl -fsSL https://ollama.com/install.sh | sh  (Mac/Linux)
#          or download from website for Windows
# Pull models: ollama pull llama3.2
# Start server: ollama serve
# To enable, uncomment below:
# USE_OLLAMA=1
# OLLAMA_URL=http://localhost:11434/api/generate

# OPTION 2: Groq API (CLOUD - FREE tier available, requires API key)
# Get key: https://console.groq.com
# Free tier: 1,000,000 tokens/day
# Fastest option, high quality
GROQ_API_KEY=gsk_your_groq_api_key_here

# OPTION 3: Demo Mode (OFFLINE - NO API NEEDED!)
# Works out of the box, no setup required
# Uses intelligent templates based on query content
# Automatically enabled if no other provider configured

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=8000
