{
  "version": 2,
  "builds": [
    {
      "src": "api/collaborative_server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/collaborative_server.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "PYTHONPATH": "."
  },
  "functions": {
    "api/collaborative_server.py": {
      "maxDuration": 60
    }
  }
}
